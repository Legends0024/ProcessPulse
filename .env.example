# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-in-production

# Database Configuration
# Development: SQLite
DATABASE_URL=sqlite:///database/processpulse.db
# Production: PostgreSQL
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Agent Configuration
AGENT_TOKEN=your-secure-agent-token-change-in-production
DEVICE_REGISTRATION_TOKEN=your-secure-enrollment-token-change-in-production
DEVICE_ADMIN_TOKEN=your-secure-device-admin-token-change-in-production
DEVICE_TOKEN=
DEVICE_TOKEN_FILE=.processpulse-device-token
ALLOW_LEGACY_AGENT_TOKEN=0
HEARTBEAT_TIMEOUT_SECONDS=30
AGENT_INTERVAL=5
API_ENDPOINT=http://localhost:5000

# ML Configuration
ML_MODEL_PATH=backend/ml/models/anomaly_detector.joblib
ML_CONTAMINATION=0.1
ML_N_ESTIMATORS=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/processpulse.log

# Rate Limiting
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_AGENT=60 per minute

# Data Retention (days)
DATA_RETENTION_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000